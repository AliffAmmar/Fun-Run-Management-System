# Copy to backend/.env and fill in. Never commit the real .env.

MONGODB_URI=mongodb://localhost:27017/run4fun
JWT_SECRET=change-me-to-a-long-random-string
# 5000 by default. On macOS, AirPlay Receiver uses 5000, so use 5001 locally.
PORT=5000
NODE_ENV=development
# Frontend address (CORS).
FRONTEND_URL=http://localhost:3000
# Base URL used in email links and QR codes. Defaults to FRONTEND_URL.
# Must be reachable from a phone when testing QR scanning (LAN IP, tunnel or deployed URL).
PUBLIC_APP_URL=

# ---- Payment ----
# mock = demo payment button (default). stripe = Stripe Checkout (not built yet).
PAYMENT_MODE=mock

# ---- Email (utils/email.js) ----
# console  = print emails in the terminal, send nothing (default)
# ethereal = free fake inbox; the terminal prints a link to view each email
# smtp     = really send (Brevo free plan: 300/day)
EMAIL_MODE=console
EMAIL_FROM="Run4Fun <your-verified-sender@example.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
