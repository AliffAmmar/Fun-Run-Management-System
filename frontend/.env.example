# Copy to frontend/.env (optional; the defaults work if the backend runs on port 5000).

# Development: the dev server forwards /api to the backend (src/setupProxy.js).
# Backend port (default 5000). On macOS AirPlay uses 5000, so the backend usually runs on 5001.
BACKEND_PORT=5001
# Or a full address instead of a port:
# BACKEND_URL=http://localhost:5001

# Only for a separately hosted backend (e.g. a deployed build): its API address.
# REACT_APP_API_URL=https://your-backend.example.com/api

# Address put in QR codes. Defaults to the address the site is opened on.
# REACT_APP_PUBLIC_URL=https://your-site.example.com

# Lets live reload work when the site is opened through a tunnel (https).
WDS_SOCKET_PORT=0
